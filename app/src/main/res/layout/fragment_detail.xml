<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollable_detail"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Detail">

    <ImageView
        android:id="@+id/iv_cover_main"
        android:layout_width="0dp"
        app:layout_constraintWidth_percent="0.6"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1"
        android:src="@drawable/iv_cover_playlist_rihanna"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tv_desc_playList"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="얄라얄라얄라셩얄라리얄라얄라얄라얄라셩얄라리얄라얄라얄라얄라셩얄라리얄라얄라얄라얄라셩얄라리얄라"
        android:gravity="center"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/iv_cover_main"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="35dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1"
        android:src="@drawable/iv_logo_white"
        app:tint="@color/green"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="@id/tv_desc_playList"
        app:layout_constraintTop_toBottomOf="@id/tv_desc_playList"/>

    <TextView
        android:id="@+id/tv_playList_category"
        android:fontFamily="@font/gotham_bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="rabia님을 위한 추천 플레이리스트"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/iv_logo"
        app:layout_constraintTop_toTopOf="@id/iv_logo"
        app:layout_constraintBottom_toBottomOf="@id/iv_logo"
        />

    <TextView
        android:id="@+id/tv_save"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="저장 횟수 :"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/iv_logo"
        app:layout_constraintStart_toStartOf="@id/iv_logo"/>

    <TextView
        android:id="@+id/tv_save_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="962824"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toEndOf="@id/tv_save"
        app:layout_constraintTop_toTopOf="@id/tv_save"
        app:layout_constraintBottom_toBottomOf="@id/tv_save"/>

    <TextView
        android:id="@+id/tv_playtime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="3시간 26분"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/tv_save_count"
        app:layout_constraintTop_toTopOf="@id/tv_save"/>

    <ImageView
        android:id="@+id/ic_plus"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/iv_plus_icon"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_save"
        app:layout_constraintStart_toStartOf="@id/tv_save"/>

    <ImageView
        android:id="@+id/ic_download"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_download"
        app:tint="#a6a6a6"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_save"
        app:layout_constraintStart_toEndOf="@id/ic_plus"/>

    <ImageView
        android:id="@+id/ic_kebab"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/iv_kebab_icon"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@id/ic_plus"
        app:layout_constraintBottom_toBottomOf="@id/ic_plus"
        app:layout_constraintStart_toEndOf="@id/ic_download"/>

    <ImageView
        android:id="@+id/ic_shuffle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_shuffle"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="@id/ic_plus"
        app:layout_constraintBottom_toBottomOf="@id/ic_plus"
        app:layout_constraintEnd_toStartOf="@id/ic_play"/>

    <ImageView
        android:id="@+id/ic_play"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/iv_play_icon"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="@id/ic_plus"
        app:layout_constraintBottom_toBottomOf="@id/ic_plus"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_song_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:layout_marginTop="16dp"
        android:nestedScrollingEnabled="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/ic_plus"
        />

    <TextView
        android:id="@+id/tv_title_another_recommend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="다른 추천 항목"
        style="@style/title_text"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="@id/rv_song_list"
        app:layout_constraintTop_toBottomOf="@id/rv_song_list"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_recommend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        android:padding="16dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/tv_title_another_recommend"
        />





</androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    </ScrollView>
