<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Home">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btn_profile"
            style="@style/profile_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:text="@string/profile_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>


        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/btn_profile">

            <com.google.android.material.chip.Chip
                style="@style/CustomChipStyle"
                android:id="@+id/btn_category_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gotham_medium"
                android:text="@string/category_all"
                android:textSize="16sp"/>

            <com.google.android.material.chip.Chip
                style="@style/CustomChipStyle"
                android:id="@+id/btn_category_music"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:fontFamily="@font/gotham_medium"
                android:text="@string/category_music"
                android:textSize="16sp"/>

            <com.google.android.material.chip.Chip
                style="@style/CustomChipStyle"
                android:id="@+id/btn_category_podcast"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:fontFamily="@font/gotham_medium"
                android:text="@string/category_podcast"
                android:textSize="16sp"/>


        </com.google.android.material.chip.ChipGroup>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@+id/layout_topbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/layout_whole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_scroll_whole"
                android:layout_marginTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="2200dp">


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_recent_playlist"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:padding="16dp"
                    app:layout_constraintHeight_percent="0.17"
                    android:nestedScrollingEnabled="false"
                    app:layout_constraintTop_toTopOf="parent"
                    >
                </androidx.recyclerview.widget.RecyclerView>


                <TextView
                    android:id="@+id/tv_content_for_me"
                    style="@style/title_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="32dp"
                    android:text="@string/title_content_for_me"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rv_recent_playlist"/>

                <ImageView
                    android:id="@+id/iv_menu_content_for_me"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/iv_kebab_icon"
                    app:layout_constraintBottom_toBottomOf="@id/tv_content_for_me"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_content_for_me"
                    app:layout_constraintWidth_percent="0.1"/>

                <ImageView
                    android:id="@+id/iv_content_for_me"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/playlist_frame"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_max="170dp"
                    app:layout_constraintHeight_percent="0.2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_content_for_me"/>

                <ImageView
                    android:id="@+id/iv_content_for_me_cover"
                    android:layout_width="170dp"
                    android:layout_height="0dp"
                    android:src="@drawable/iv_cover_recommend_hyang"
                    app:layout_constraintHeight_max="170dp"
                    app:layout_constraintHeight_percent="0.2"
                    app:layout_constraintStart_toStartOf="@id/iv_content_for_me"
                    app:layout_constraintTop_toTopOf="@id/iv_content_for_me"/>

                <TextView
                    android:id="@+id/tv_content_for_me_category_album"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/product_sans_black"
                    android:text="싱글"
                    android:textColor="@color/light_grey"
                    app:layout_constraintStart_toEndOf="@+id/iv_content_for_me_cover"
                    app:layout_constraintTop_toTopOf="@+id/iv_content_for_me"/>

                <TextView
                    android:id="@+id/tv_content_for_me_name_album"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/circularsp_bold"
                    android:text="Hyang - Summer"
                    android:textColor="@color/white"
                    app:layout_constraintStart_toEndOf="@+id/iv_content_for_me_cover"
                    app:layout_constraintTop_toBottomOf="@id/tv_content_for_me_category_album"/>

                <TextView
                    android:id="@+id/tv_content_for_me_description_album"
                    style="@style/description_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="8dp"
                    android:text="Spotify 에디터가\n추천하는 트랙"
                    app:layout_constraintStart_toEndOf="@+id/iv_content_for_me_cover"
                    app:layout_constraintTop_toBottomOf="@id/tv_content_for_me_name_album"/>

                <ImageView
                    android:id="@+id/iv_content_for_me_icon_plus"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="16dp"
                    android:src="@drawable/iv_plus_icon"
                    app:layout_constraintBottom_toBottomOf="@id/iv_content_for_me"
                    app:layout_constraintHeight_percent="0.04"
                    app:layout_constraintStart_toEndOf="@+id/iv_content_for_me_cover"
                    app:layout_constraintTop_toBottomOf="@+id/tv_content_for_me_description_album"
                    app:layout_constraintWidth_percent="0.08"/>

                <ImageView
                    android:id="@+id/iv_content_for_me_icon_play"
                    android:layout_width="0dp"
                    app:layout_constraintWidth_percent="0.13"
                    android:layout_height="0dp"
                    app:layout_constraintHeight_percent="0.06"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/iv_play_icon"
                    app:layout_constraintBottom_toBottomOf="@id/iv_content_for_me_icon_plus"
                    app:layout_constraintEnd_toEndOf="@id/iv_content_for_me"
                    app:layout_constraintTop_toTopOf="@id/iv_content_for_me_icon_plus"/>

                <TextView
                    android:id="@+id/tv_recommend_station"
                    style="@style/title_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="32dp"
                    android:text="@string/title_recommend_station"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/iv_content_for_me"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_recommend_station"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@id/tv_recommend_station">

                </androidx.recyclerview.widget.RecyclerView>


                <TextView
                    android:id="@+id/tv_mix_for_user"
                    style="@style/title_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="16dp"
                    android:text="@string/title_recommend_mix_for_user"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/rv_recommend_station"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_mix_for_user"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintTop_toBottomOf="@id/tv_mix_for_user">

                </androidx.recyclerview.widget.RecyclerView>

                <TextView
                    android:id="@+id/tv_user_mix"
                    style="@style/title_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="16dp"
                    android:text="@string/title_user_mix"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/rv_mix_for_user"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_user_mix"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintTop_toBottomOf="@id/tv_user_mix">
                </androidx.recyclerview.widget.RecyclerView>

                <ImageView
                    android:id="@+id/iv_radio_artist_circle"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/button_shape_profile"
                    android:src="@drawable/iv_cover_playlist_hyang"
                    android:clipToOutline="true"
                    android:scaleType="fitCenter"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="16dp"
                    app:layout_constraintTop_toBottomOf="@id/rv_user_mix"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/tv_radio_artist_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/product_sans_black"
                    android:text="Hyang"
                    android:textSize="20sp"
                    android:layout_marginStart="8dp"
                    app:layout_constraintStart_toEndOf="@+id/iv_radio_artist_circle"
                    app:layout_constraintTop_toTopOf="@+id/iv_radio_artist_circle"/>

                <TextView
                    android:id="@+id/tv_radio_addtext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/product_sans_black"
                    android:text="더 파고들기"
                    android:textSize="16sp"
                    android:layout_marginStart="4dp"
                    app:layout_constraintStart_toEndOf="@+id/tv_radio_artist_name"
                    app:layout_constraintTop_toTopOf="@+id/tv_radio_artist_name"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_radio_artist_name"/>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_radio"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintHeight_percent="0.23"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@+id/iv_radio_artist_circle">

                    <ImageView
                        android:id="@+id/iv_radio_artist_photo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="16dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/iv_cover_playlist_hyang"
                        android:scaleType="centerCrop"/>

                    <ImageView
                        android:id="@+id/iv_radio_artist_photo_gradient"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/gradient_radio_artist_photo"
                        tools:layout_editor_absoluteX="16dp"
                        tools:layout_editor_absoluteY="16dp" />

                    <ImageView
                        android:id="@+id/iv_radio_mix_cover"
                        android:layout_width="0dp"
                        app:layout_constraintWidth_percent="0.22"
                        android:layout_height="0dp"
                        app:layout_constraintHeight_percent="0.18"
                        android:src="@drawable/iv_cover_recommend_hyang"
                        android:layout_marginTop="32dp"
                        android:layout_marginStart="32dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tv_radio_name"
                        style="@style/title_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hyang\n라디오"
                        android:layout_marginStart="16dp"
                        app:layout_constraintTop_toTopOf="@id/iv_radio_mix_cover"
                        app:layout_constraintStart_toEndOf="@id/iv_radio_mix_cover"/>

                    <TextView
                        android:id="@+id/tv_radio_category"
                        style="@style/description_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="플레이리스트 Spotify"
                        app:layout_constraintTop_toBottomOf="@+id/tv_radio_name"
                        app:layout_constraintStart_toStartOf="@+id/tv_radio_name"/>

                    <ImageView
                        android:id="@+id/iv_plus_icon_radio"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintWidth_percent="0.1"
                        app:layout_constraintHeight_percent="0.08"
                        android:src="@drawable/iv_plus_icon"
                        app:tint="@color/white"
                        android:layout_marginEnd="32dp"
                        app:layout_constraintTop_toTopOf="@+id/iv_radio_mix_cover"
                        app:layout_constraintBottom_toBottomOf="@+id/iv_radio_mix_cover"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <ImageView
                        android:id="@+id/iv_previous_icon"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintWidth_percent="0.12"
                        app:layout_constraintHeight_percent="0.1"
                        android:src="@drawable/iv_previous_icon"
                        android:layout_marginStart="32dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <ImageView
                        android:id="@+id/iv_next_icon"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintWidth_percent="0.12"
                        app:layout_constraintHeight_percent="0.1"
                        android:src="@drawable/iv_next_icon"
                        android:layout_marginEnd="32dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <TextView
                        android:id="@+id/tv_radio_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hyang,The1975,HeMeets,너드커넥션,잔나비\n외 다양한 아티스트와 함꼐"
                        android:textSize="16sp"
                        android:layout_marginStart="32dp"
                        android:layout_marginBottom="16dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toTopOf="@+id/layout_button_pre_listen"/>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_button_pre_listen"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        app:layout_constraintHeight_percent="0.1"
                        android:background="@drawable/button_pre_listen"
                        android:paddingStart="8dp"
                        android:layout_marginStart="32dp"
                        android:layout_marginBottom="32dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <ImageView
                            android:id="@+id/iv_silent_icon"
                            android:layout_width="0dp"
                            app:layout_constraintWidth_percent="0.18"
                            android:layout_height="0dp"
                            android:src="@drawable/iv_silient_icon"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"/>

                        <TextView
                            android:id="@+id/tv_pre_listen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="플레이리스트 미리 듣기"
                            android:textSize="16sp"
                            android:layout_marginEnd="16dp"
                            app:layout_constraintTop_toTopOf="@id/iv_silent_icon"
                            app:layout_constraintBottom_toBottomOf="@id/iv_silent_icon"
                            app:layout_constraintStart_toEndOf="@id/iv_silent_icon"
                            app:layout_constraintEnd_toEndOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <ImageView
                        android:id="@+id/iv_radio_kebab_icon"
                        android:layout_width="0dp"
                        app:layout_constraintWidth_percent="0.13"
                        android:layout_height="0dp"
                        android:src="@drawable/iv_kebab_icon"
                        app:tint="@color/white"
                        app:layout_constraintTop_toTopOf="@+id/layout_button_pre_listen"
                        app:layout_constraintStart_toEndOf="@+id/layout_button_pre_listen"
                        app:layout_constraintEnd_toStartOf="@+id/iv_radio_play_icon"
                        app:layout_constraintBottom_toBottomOf="@+id/layout_button_pre_listen"/>

                    <ImageView
                        android:id="@+id/iv_radio_play_icon"
                        android:layout_width="0dp"
                        app:layout_constraintWidth_percent="0.13"
                        android:layout_height="0dp"
                        android:src="@drawable/iv_play_icon"
                        android:layout_marginEnd="32dp"
                        app:layout_constraintTop_toTopOf="@+id/layout_button_pre_listen"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="@+id/layout_button_pre_listen"/>





                </androidx.constraintlayout.widget.ConstraintLayout>






            </androidx.constraintlayout.widget.ConstraintLayout>


        </LinearLayout>

    </ScrollView>



</androidx.constraintlayout.widget.ConstraintLayout>